# EXPERIMENTAL, NOT HARDWARE-TESTED: this is not a confirmed PF1006 board port.
# Baseline: pinned U-Boot v2025.10 Sinlinx_SinA33_defconfig, as used by the
# existing A33 diagnostics. PF1006 DRAM, PMIC, voltages and pinout are unverified.
# 456 MHz is inherited from the PF1007L experiment, not measured on PF1006.
CONFIG_DRAM_CLK=456
CONFIG_DRAM_ZQ=15291
CONFIG_MMC_SUNXI_SLOT_EXTRA=2
CONFIG_TEXT_BASE=0x4a000000
CONFIG_LOCALVERSION="-pf1006-probe"
# CONFIG_LOCALVERSION_AUTO is not set

# Disable another board's display and USB pins, update interfaces and network.
# CONFIG_VIDEO_SUNXI is not set
# CONFIG_VIDEO is not set
# CONFIG_CMD_DFU is not set
# CONFIG_DFU is not set
# CONFIG_DFU_RAM is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_FASTBOOT_CMD_OEM_FORMAT is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_USB_FUNCTION_MASS_STORAGE is not set
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_GADGET is not set
# CONFIG_SPL_USB_GADGET is not set
# CONFIG_USB_HOST is not set
# CONFIG_SPL_USB_HOST is not set
# CONFIG_USB_ETHER is not set
# CONFIG_USB is not set
CONFIG_NO_NET=y
# CONFIG_NET is not set
# CONFIG_NET_LWIP is not set
# CONFIG_NETDEVICES is not set

# Driver patch blocks non-SD block writes/erases and persistent EXT_CSD changes.
# These additional paths must be absent, especially raw vendor boot resizing.
# CONFIG_SUPPORT_EMMC_BOOT is not set
# CONFIG_SUPPORT_EMMC_RPMB is not set
# CONFIG_CMD_MMC_RPMB is not set
# CONFIG_MMC_HW_PARTITIONING is not set
# CONFIG_CMD_BKOPS_ENABLE is not set
# CONFIG_CMD_MMC_SWRITE is not set

# No persistent environment, boot counter, alternate boot path or interactive
# recovery prompt. A failed load/source reaches the unconditional idle loop.
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_SPL_ENV_SUPPORT is not set
# CONFIG_SPL_SAVEENV is not set
# CONFIG_CMD_SAVEENV is not set
# CONFIG_CMD_ERASEENV is not set
# CONFIG_CMD_IMPORTENV is not set
# ARCH_SUNXI selects USE_PREBOOT unconditionally. Keep its command empty and
# verify PREBOOT_DEFINED is absent so the inherited "usb start" cannot run.
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT=""
# CONFIG_PREBOOT_DEFINED is not set
# CONFIG_ENV_USE_DEFAULT_ENV_TEXT_FILE is not set
# CONFIG_BOOT_RETRY is not set
# CONFIG_BOOTCOUNT_LIMIT is not set
# CONFIG_BOOTSTD is not set
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_EFI_LOADER is not set
# EFI capsule creation is unrelated to this SD image and needs extra host libs.
# CONFIG_TOOLS_MKEFICAPSULE is not set
# CONFIG_CMD_BOOTD is not set
# CONFIG_CMD_BOOTM is not set
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_GO is not set
# This diagnostic never hands off to an OS. Remove the associated non-secure,
# hypervisor and PSCI monitor code along with bootm/bootz/EFI. Keeping the monitor
# enabled with no callers leaves an empty secure section in this pinned linker.
# CONFIG_ARMV7_NONSEC is not set
# CONFIG_ARMV7_VIRT is not set
# CONFIG_ARMV7_PSCI is not set
CONFIG_AUTOBOOT=y
# CONFIG_AUTOBOOT_KEYED is not set
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_SYS_DEVICE_NULLDEV=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_BOARD_LATE_INIT=y

# SPL guard refuses <256 MiB before loading U-Boot at +160 MiB. Repeat the
# guard here before loading the <=64 KiB script at +49 MiB; no fallback boot.
CONFIG_BOOTCOMMAND="if setenv stdin nulldev && test -n \"${pf1006_ram_bytes}\" && itest.l ${pf1006_ram_bytes} -ge 0x10000000; then if fatload mmc 0:1 0x43100000 pf1006-probe.scr 0x10000; then source 0x43100000; fi; fi; while true; do sleep 1; done"

# Commands used by probe.cmd.in. The status export needs more than16 arguments.
CONFIG_HUSH_PARSER=y
CONFIG_CMD_RUN=y
CONFIG_CMD_SOURCE=y
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SLEEP=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_MMC=y
CONFIG_CMD_MMC_REG=y
CONFIG_CMD_FAT=y
CONFIG_FAT_WRITE=y
CONFIG_CMD_HASH=y
CONFIG_SHA256=y
CONFIG_CMD_EXPORTENV=y
CONFIG_SYS_MAXARGS=32
CONFIG_SYS_CBSIZE=2048
